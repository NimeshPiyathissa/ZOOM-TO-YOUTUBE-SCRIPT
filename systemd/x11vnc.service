[Unit]
Description=x11vnc remote GUI for :99 (localhost only, view+control)
After=xvfb.service
Requires=xvfb.service
# Give up after 5 failures within 5 minutes - see ffmpeg-stream.service.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
Environment=DISPLAY=:99
Nice=10
# Bumped from 20: gives x11vnc more of a look-in against ffmpeg-stream's
# CPUWeight=800 while live, so screen polling/serving stays responsive
# instead of visibly lagging under encoder load. Still far below the
# encoder's share - this is headroom, not parity.
CPUWeight=60
ExecStart=%h/zoom-stream/scripts/start-vnc.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
