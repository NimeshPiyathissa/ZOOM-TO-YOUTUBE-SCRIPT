[Unit]
Description=Zoom Stream Dashboard (FastAPI)
After=network.target

[Service]
Type=simple
User=dashboard
Group=dashboard
WorkingDirectory=/home/dashboard/app
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/dashboard/venv/bin/uvicorn app.main:app \
  --host 0.0.0.0 --port 443 --workers 1 \
  --ssl-keyfile /home/dashboard/certs/key.pem --ssl-certfile /home/dashboard/certs/cert.pem
# Bound to all interfaces on 443 by design - reachable directly at
# https://<vps-ip>, no SSH tunnel required. Port 443 is normally
# root-only; this grants just the one capability needed to bind it
# without running the process as root itself (the "real" security
# boundary for everything this service touches is still the sudoers
# allowlist below, same as before this changed).
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=5
# Lower scheduling priority than the encoder (ffmpeg-stream runs at
# Nice=0 under zoombot) so watching the dashboard never steals cycles
# from the stream. No filesystem sandboxing here (ProtectHome/
# ProtectSystem/NoNewPrivileges) - this service works entirely through
# `sudo -u zoombot <allowlisted command>`, which needs to both invoke a
# setuid binary (breaks under NoNewPrivileges) and let the sudo'd child
# write into zoombot's home (breaks under a namespace-inherited
# read-only ProtectHome). The real privilege boundary here is the
# sudoers allowlist, not systemd sandboxing.
Nice=10
CPUWeight=50
MemoryMax=512M
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
