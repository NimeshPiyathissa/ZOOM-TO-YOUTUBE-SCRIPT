[Unit]
Description=Openbox window manager on :99
After=xvfb.service
Requires=xvfb.service
# Give up after 5 failures within 5 minutes - see ffmpeg-stream.service.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
Environment=DISPLAY=:99
ExecStart=%h/zoom-stream/scripts/start-openbox.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
